# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Lấy tại SSI Developer Portal > Quản lý API Key (chỉ cần quyền "All api data").
SSI_API_KEY=your_api_key_here
SSI_API_SECRET=your_api_secret_here

# Tùy chọn: nơi lưu cơ sở dữ liệu SQLite (mặc định storage/radar.db)
# RADAR_DB_PATH=storage/radar.db

# Dự án chỉ ĐỌC dữ liệu thị trường: không dùng Private Key, không truyền OTP.
